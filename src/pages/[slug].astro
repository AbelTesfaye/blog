---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts } from '../posts';
import { url, formatDate } from '../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="muted">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span> · updated {formatDate(updatedDate)}</span>}
    </p>
    {tags.length > 0 && <p>{tags.map((t) => <a class="tag" href={url(`/tags/${t}/`)}>{t}</a>)}</p>}
    <Content />
  </article>
  <p><a href={url('/')}>← All posts</a></p>
</Base>
