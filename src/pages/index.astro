---
import Base from '../layouts/Base.astro';
import { getPosts } from '../posts';
import { url, formatDate } from '../utils';

const posts = await getPosts();
---

<Base>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <time class="muted" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <a class="title" href={url(`/${post.id}/`)}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li { margin-bottom: 2.25rem; }
  .title { display: block; font-size: 1.35rem; font-weight: 650; color: inherit; text-decoration: none; margin: 0.15rem 0 0.25rem; }
  .title:hover { color: var(--accent); }
  p { margin: 0; color: var(--muted); }
</style>
