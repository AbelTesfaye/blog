---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../posts';
import { url, formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`Posts tagged “${tag}”`}>
  <h1>#{tag}</h1>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={url(`/${post.id}/`)}>{post.data.title}</a> <span class="muted">· {formatDate(post.data.pubDate)}</span>
        </li>
      ))
    }
  </ul>
  <p><a href={url('/tags/')}>← All tags</a></p>
</Base>
